    classDef apiStyle fill:#E1F5FE,stroke:#0277BD,stroke-width:2px
    classDef dbStyle fill:#F5F5F5,stroke:#666666,stroke-width:2px
    classDef redisStyle fill:#FFCDD2,stroke:#C62828,stroke-width:2px
