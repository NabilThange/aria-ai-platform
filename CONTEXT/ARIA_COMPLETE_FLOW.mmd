    class DA_AGENT,DA_CONTEXT,DA_ITER,DA_SCREENSHOT,DA_PERCEPTION,DA_LLM,DA_TOOLS,DA_EXECUTE,DA_CHECK,DA_COMPLETE,DA_CONTINUE,DA_MAX desktopStyle
    class WA_AGENT,WA_EAGER,WA_CONTEXT,WA_ITER,WA_SNAPSHOT,WA_PERCEPTION,WA_AUTO,WA_LLM,WA_TOOLS,WA_EXECUTE,WA_CHECK,WA_COMPLETE,WA_CONTINUE,WA_MAX webStyle
    class WF_SERVICE,WF_LOAD,WF_META,WF_VALIDATE,WF_SERVICES,WF_EXECUTE,WF_STEPS,WF_OUTPUT workflowStyle
    class VE_AGENT,VE_CONTEXT,VE_LLM,VE_OUTPUT,VE_DECISION,VE_SUCCESS,VE_FAILURE verifierStyle
    class ESC_START,ESC_COUNTER,ESC_L1,ESC_L2,ESC_L3,ESC_L4,REC_AGENT,REC_CONTEXT,REC_OUTPUT,REC_RETRY,REC_CHECK,REC_CONTINUE,REC_ESCALATE recoveryStyle
    class REP_AGENT,REP_CONTEXT,REP_LLM,REP_OUTPUT,REP_SAVE reporterStyle
    class PINCHTAB,VNC externalStyle
    class FRONTEND frontendStyle
    class CL_COST,OR_COST,DA_COST,WA_COST,WF_COST,VE_COST,ESC_COST,REP_COST costStyle
