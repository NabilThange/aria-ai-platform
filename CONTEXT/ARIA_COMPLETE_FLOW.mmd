    class USER,CL_INPUT,OR_INPUT,DA_INPUT,WA_INPUT,WF_INPUT,VE_INPUT,REP_INPUT userStyle
    class API,ORCH_START apiStyle
    class DB dbStyle
    class REDIS,STATE_UPDATE redisStyle
    class WS,WS_EMIT wsStyle
