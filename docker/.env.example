# ARIA Docker Environment Variables
# Copy this file to .env and add your actual API keys

# ============================================================================
# AI API KEYS (REQUIRED - Add your keys here!)
# ============================================================================

# Groq Cloud API (Optional - Add your key(s) to enable Groq models)
# Get your API key from: https://console.groq.com/keys
# You can add multiple keys for automatic fallback:
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Google AI Studio API (Optional - Add your key(s) to enable Google models)
# Get your API key from: https://aistudio.google.com/app/apikey
# You can add multiple keys for automatic fallback:
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# Bytez API (Optional - Add your key(s) to enable Bytez models)
# Get your API key from: https://bytez.com
# You can add multiple keys for automatic fallback:
BYTEZ_API_KEY_1=
BYTEZ_API_KEY_2=
BYTEZ_API_KEY_3=
BYTEZ_API_KEY_4=
BYTEZ_API_KEY_5=
BYTEZ_API_KEY_6=
BYTEZ_API_KEY_7=
BYTEZ_API_KEY_8=
BYTEZ_API_KEY_9=
BYTEZ_API_KEY_10=
BYTEZ_API_KEY_11=
BYTEZ_API_KEY_12=
BYTEZ_API_KEY_13=
BYTEZ_API_KEY_14=
BYTEZ_API_KEY_15=
BYTEZ_API_KEY_16=
BYTEZ_API_KEY_17=
BYTEZ_API_KEY_18=
BYTEZ_API_KEY_19=
BYTEZ_API_KEY_20=

PINCHTAB_HEADED_MODE=true

# ============================================================================
# DATABASE & REDIS (Already configured - don't change)
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ariadb
REDIS_URL=redis://redis:6379

# ============================================================================
# SERVICE URLS (Already configured - don't change)
# ============================================================================
ARIA_DESKTOP_BASE_URL=http://aria-desktop:9990
PINCHTAB_BASE_URL=http://aria-desktop:9867
PINCHTAB_AUTH_TOKEN=
ARIA_AGENT_BASE_URL=http://aria-agent:9991
ARIA_DESKTOP_VNC_URL=http://aria-desktop:9990/websockify

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================
# Multi-Agent System (set to true to enable)
ENABLE_MULTI_AGENT=true

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Cloud (optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
