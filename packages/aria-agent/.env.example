# Database
DATABASE_URL="file:./dev.db"

# Google Gemini API
# Get your API key from: https://aistudio.google.com/apikey
# Free tier: 20 requests/day on gemini-2.5-flash-lite
GOOGLE_API_KEY=your_google_api_key_here
# OR use GEMINI_API_KEY (both work, GOOGLE_API_KEY takes precedence)
# GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API
# Get your API key from: https://console.groq.com/keys
# Free tier: Very generous limits, extremely fast inference
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API
# Get your API key from: https://openrouter.ai/keys
# Access to 100+ models from multiple providers
# Some models are free, others require credits
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Analytics (Optional)
# ARIA_ANALYTICS_ENDPOINT=your_analytics_endpoint_here

# Server Configuration
PORT=3001

# Multi-Agent System (Feature Flag)
# Set to 'true' to enable the new multi-agent orchestration system
# Set to 'false' to use the legacy single-agent mode (default)
ENABLE_MULTI_AGENT=true

# Redis (Required for Multi-Agent System)
# Redis is used for shared state management between agents
REDIS_URL=redis://localhost:6379

# Telegram Notifications (Optional)
# Used by ReporterAgent to send task summaries
# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
