# ============================================
# DOCKER DEPLOYMENT ENVIRONMENT
# ============================================
# Use this when running aria-agent IN A DOCKER CONTAINER
# All services communicate via Docker service names

# Database (PostgreSQL container)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ariadb

# Redis (Redis container)
REDIS_URL=redis://redis:6379

# Desktop Service (aria-desktop container)
ARIA_DESKTOP_BASE_URL=http://aria-desktop:9990

# PinchTab (part of aria-desktop container)
PINCHTAB_BASE_URL=http://aria-desktop:9867

# Multi-Agent System
ENABLE_MULTI_AGENT=true
AUTO_APPROVE_PLAN=false

# Server Port
PORT=9991

# API Keys (passed from host environment or .env file in docker/ directory)
# These will be injected by docker-compose from the host environment
